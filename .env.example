# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# Any long random string for local work:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me

# Which settings module to use: config.settings.local | config.settings.test | config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.local

# Local Postgres (Homebrew postgresql@16). In production this points at RDS.
DATABASE_URL=postgres://localhost:5432/maasermart

DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Production only ---
# DJANGO_CSRF_TRUSTED_ORIGINS=https://maasermart.com
# DJANGO_LOG_DIR=/var/log/maasermart
# CELERY_BROKER_URL=sqs://
# AWS_REGION=us-east-1
# EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=no-reply@maasermart.com
