# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# Any long random string for local work:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me

# Local Postgres (Homebrew postgresql@16). In production this points at RDS.
DATABASE_URL=postgres://localhost:5432/maasermart

# --- The deployed RDS database (D-070) ---
# To point the app at RDS instead of local Postgres, replace DATABASE_URL above
# with the instance's endpoint. `sslmode=require` is not optional: RDS refuses
# unencrypted connections. The database itself must already exist.
#   DATABASE_URL=postgres://USER:PASSWORD@INSTANCE.xxxxx.REGION.rds.amazonaws.com:5432/DBNAME?sslmode=require
#
# The instance is stopped when nobody is using it, so the app asks the AWS API
# whether it is up and starts it if it is not. Leave these unset for local
# Postgres: then the app never calls AWS at all.
#   RDS_INSTANCE_ID=maasermart-db
#
# The region is AWS_REGION, in the production block below. Credentials come from
# the usual AWS variables (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY) or a
# ~/.aws profile; the identity needs rds:DescribeDBInstances and
# rds:StartDBInstance on that instance.
#   DATABASE_WAKE_RETRY_AFTER=15

DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated hosts an external charity image may come from (optional).
# CHARITY_IMAGE_HOSTS=images.example.org,.cdn.example.org

# Password for the admin user `manage.py seed` creates. Leave unset to have the
# seed generate one and print it once (D-062).
# ADMIN_SEED_PASSWORD=

# --- The chatbot's model (D-075) ---
# "fake" (the default outside production) needs no key and echoes the question.
# Switch by name, or give the dotted path of your own ChatProvider subclass.
#   CHATBOT_PROVIDER=deepseek
#   CHATBOT_MODEL=            # empty: the provider's default model
#   OPENAI_API_KEY=
#   DEEPSEEK_API_KEY=
#   CHATBOT_DAILY_LIMIT=30     # questions per member per UTC day
#   CHATBOT_ANSWER_SECONDS=120 # then the panel says "try again"

# --- Production only ---
# DJANGO_CSRF_TRUSTED_ORIGINS=https://maasermart.com
# DJANGO_LOG_DIR=/var/log/maasermart
# CELERY_BROKER_URL=sqs://
# AWS_REGION=us-east-2
# EMAIL_HOST=email-smtp.us-east-2.amazonaws.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=no-reply@maasermart.com

# Recommendation tuning (provisional; fractions of qualifying activity).
# RECOMMENDATIONS_MIN_HISTORY=3
# RECOMMENDATIONS_THRESHOLD=0.2
# RECOMMENDATIONS_SINGLE_OFFSET=0.1
# RECOMMENDATIONS_PAIR_OFFSET=0.2
