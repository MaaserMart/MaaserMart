# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# Any long random string for local work:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me

# Local Postgres (Homebrew postgresql@16). In production this points at RDS.
DATABASE_URL=postgres://localhost:5432/maasermart

DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Production only ---
# All AWS resources live in us-east-2 (D-044). Ask the AWS owner for the real values; never commit them.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://maasermart.com
# DJANGO_LOG_DIR=/var/log/maasermart
# RDS (PostgreSQL 16; SSL is required, which psycopg does by default):
# DATABASE_URL=postgres://maasermart_admin:<password>@maasermart-db.cdo86eew2ig5.us-east-2.rds.amazonaws.com:5432/maasermart
# CELERY_BROKER_URL=sqs://
# AWS_REGION=us-east-2
# SQS_QUEUE_URL=https://sqs.us-east-2.amazonaws.com/744924927896/maasermart-tasks
# EMAIL_HOST=email-smtp.us-east-2.amazonaws.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=MaaserMart <no-reply@maasermart.com>
